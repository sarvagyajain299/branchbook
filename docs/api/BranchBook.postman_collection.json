{
  "info": {
    "name": "BranchBook API v1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run the folders top to bottom. Start the app (sail up -d), seed it, and read codes in Mailpit at http://localhost:8026. Staff logins use the demo password `password`."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost/api/v1"
    },
    {
      "key": "date",
      "value": "2026-12-07"
    },
    {
      "key": "slotStart",
      "value": ""
    },
    {
      "key": "reference",
      "value": ""
    },
    {
      "key": "manageToken",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "ticketId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Public",
      "item": [
        {
          "name": "List branches (nearest to Dubai Marina)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/branches?lat=25.08&lng=55.14",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "branches"
              ],
              "query": [
                {
                  "key": "lat",
                  "value": "25.08"
                },
                {
                  "key": "lng",
                  "value": "55.14"
                }
              ]
            }
          }
        },
        {
          "name": "List services",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/services",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "services"
              ]
            }
          }
        },
        {
          "name": "Availability",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/branches/DXB-MAR/availability?service=PAO&date={{date}}&days=3",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "branches",
                "DXB-MAR",
                "availability"
              ],
              "query": [
                {
                  "key": "service",
                  "value": "PAO"
                },
                {
                  "key": "date",
                  "value": "{{date}}"
                },
                {
                  "key": "days",
                  "value": "3"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const days = pm.response.json().data;",
                  "const first = days.find(d => d.slots.length);",
                  "if (first) pm.collectionVariables.set('slotStart', first.slots[0].starts_at);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Booking",
      "item": [
        {
          "name": "Create booking (holds the slot, emails a code)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/bookings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bookings"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"service\": \"PAO\",\n  \"branch\": \"DXB-MAR\",\n  \"starts_at\": \"{{slotStart}}\",\n  \"first_name\": \"Sarah\",\n  \"last_name\": \"Jones\",\n  \"email\": \"sarah.jones@example.com\",\n  \"phone\": \"050 123 4567\",\n  \"consent\": true\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('reference', pm.response.json().data.reference);"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify with the code from Mailpit",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/bookings/{{reference}}/verify",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bookings",
                "{{reference}}",
                "verify"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"123456\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json(); if (j.manage_token) pm.collectionVariables.set('manageToken', j.manage_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "View booking",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-Manage-Token",
                "value": "{{manageToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/bookings/{{reference}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bookings",
                "{{reference}}"
              ]
            }
          }
        },
        {
          "name": "Reschedule booking (new reference + token in the response)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Manage-Token",
                "value": "{{manageToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/bookings/{{reference}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bookings",
                "{{reference}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"starts_at\": \"{{slotStart}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json(); if (j.manage_token) { pm.collectionVariables.set('manageToken', j.manage_token); pm.collectionVariables.set('reference', j.data.reference); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Cancel booking",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Manage-Token",
                "value": "{{manageToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/bookings/{{reference}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bookings",
                "{{reference}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Plans changed\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "3. Staff",
      "item": [
        {
          "name": "Front desk token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/tokens",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "tokens"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"desk.dxb@northwind.test\",\n  \"password\": \"password\",\n  \"device_name\": \"postman\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('token', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Issue walk-in ticket",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/branches/DXB-MAR/queue/walk-ins",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "branches",
                "DXB-MAR",
                "queue",
                "walk-ins"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"service\": \"PAO\",\n  \"name\": \"Walk Inn\"\n}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Today's queue",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/branches/DXB-MAR/queue?status=waiting",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "branches",
                "DXB-MAR",
                "queue"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "waiting"
                }
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Advisor token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/tokens",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "tokens"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"advisor.dxb1@northwind.test\",\n  \"password\": \"password\",\n  \"device_name\": \"postman\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('token', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Call next",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/queue/call-next",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "queue",
                "call-next"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json().data; if (d) pm.collectionVariables.set('ticketId', d.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Start",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/queue-tickets/{{ticketId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "queue-tickets",
                "{{ticketId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"start\"\n}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Complete",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/queue-tickets/{{ticketId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "queue-tickets",
                "{{ticketId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"complete\"\n}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Log out (revoke token)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/tokens/current",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "tokens",
                "current"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}